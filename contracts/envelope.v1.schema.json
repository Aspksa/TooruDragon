{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toorudragon.local/contracts/envelope.v1.schema.json",
  "title": "TooruDragon Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "version",
    "id",
    "source",
    "timestamp",
    "trace_id",
    "payload"
  ],
  "properties": {
    "protocol": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"
    },
    "version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    }
  }
}
