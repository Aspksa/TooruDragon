{
  "version": "0.2.0-alpha",
  "database": {
    "engine": "sqlite",
    "path": "data/toorudragon.db"
  },
  "auth": {
    "required": false,
    "token_env": "TOORUDRAGON_API_TOKEN"
  },
  "logging": {
    "directory": "logs",
    "rotation_bytes": 2000000,
    "backup_count": 5
  },
  "update": {
    "remote": "origin",
    "branch": "main",
    "strategy": "ff-only",
    "backup_before_update": true,
    "rollback_on_validation_failure": true,
    "backup_retention": 10
  },
  "backup": {
    "directory": "backups",
    "retention": 10
  },
  "service_registry": {
    "heartbeat_seconds": 10,
    "stale_after_seconds": 35
  },
  "watchdog": {
    "enabled": true,
    "interval_seconds": 10,
    "failure_threshold": 3,
    "auto_restart": true
  },
  "event_bus": {
    "max_events": 500
  },
  "workflow": {
    "lease_seconds": 60,
    "max_attempts": 3,
    "requeue_expired_on_start": true
  },
  "policy": {
    "_default": "deny",
    "main": [
      "system.core.manage",
      "workflow.manage",
      "workflow.worker",
      "secrets.metadata"
    ],
    "tooru_ai": [
      "workflow.create",
      "workflow.read"
    ],
    "laboratory": [
      "workflow.create",
      "workflow.read",
      "workflow.worker"
    ],
    "home": [
      "workflow.create",
      "workflow.read",
      "workflow.worker"
    ],
    "work": [
      "workflow.create",
      "workflow.read",
      "workflow.worker"
    ],
    "mobile": [
      "workflow.create",
      "workflow.read"
    ]
  }
}
